    "    settings.nblades = nblades[i]\n",
    "    settings.ity = 5 # x,y,z\n",
    "    settings.lete = 10\n",
    "    outlet = Outlet_bcs(rpm=RPM[i],gamma=1.3,\n",
    "                    psout=P,twall=0,molwt=28.96)\n",
    "    agf = AGF_Setup(template_file='template.agf',name=f\"EEE-HPT-{i}\")\n",
